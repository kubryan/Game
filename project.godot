; Engine configuration file.
; Fairy Corruption TD - Windows prototype
config_version=5

[application]
config/name="腐化童話：夜守者"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
spell_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
spell_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
spell_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
spell_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}

[autoload]
InputSettings="*res://scripts/InputSettings.cs"

[dotnet]
project/assembly_name="FairyCorruptionTD"
